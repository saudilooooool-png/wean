# ─────────────────────────────────────────────────────────────────────────────
# Wean – WhatsApp Location Search
# Copy this file to .env and fill in all values before running docker-compose
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info
TIMEZONE=Asia/Riyadh

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=wean
POSTGRES_PASSWORD=wean_secret_change_me
POSTGRES_DB=wean

# ── n8n DB (separate user inside the same Postgres instance) ──────────────────
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_secret_change_me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret_change_me

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
# Public URL where Evolution API is reachable from outside (for QR scanning)
EVOLUTION_SERVER_URL=http://localhost:8080
# Strong random key – used in X-API-KEY header for all Evolution API calls
EVOLUTION_API_KEY=evolution_api_key_change_me
# The WhatsApp instance name you will create via the Evolution API
EVOLUTION_INSTANCE_NAME=wean_bot

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
# Must match the URL n8n is publicly accessible on (used for webhook URLs)
N8N_WEBHOOK_URL=http://localhost:5678
# Minimum 32-character random string
N8N_ENCRYPTION_KEY=change_me_32_chars_minimum_length_here
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_secret_change_me

# ── Groq (مجاني) ─────────────────────────────────────────────────────────────
# احصل على مفتاح مجاني من: https://console.groq.com
# النموذج المستخدم: llama-3.3-70b-versatile (مجاني)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ملاحظة: لا يوجد Google Maps API key — نستخدم Playwright Scraping مجاناً

# ── Appwrite ──────────────────────────────────────────────────────────────────
# Internal endpoint used by LangChain service (container-to-container)
APPWRITE_ENDPOINT=http://appwrite:80/v1
# Created after first boot at http://localhost/console
APPWRITE_PROJECT_ID=wean_project
# Server-side API key with full database permissions
APPWRITE_API_KEY=appwrite_api_key_change_me
APPWRITE_ADMIN_EMAIL=admin@wean.local
APPWRITE_ADMIN_PASSWORD=Admin@12345_change_me
APPWRITE_DOMAIN=localhost
# 32-byte random hex string
APPWRITE_OPENSSL_KEY=your_openssl_key_32_bytes_hex_change_me
